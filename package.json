    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "fontkit": "^2.0.4",
    "mupdf": "^1.28.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0",
    "pdfkit": "^0.15.0"
  }
