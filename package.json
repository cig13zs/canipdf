{
  "name": "canipdf",
  "version": "0.1.0",
  "description": "Conformance tests for JavaScript PDF libraries: does it actually work, or does it just have a README?",
  "type": "module",
  "bin": {
    "canipdf": "src/cli.js"
  },
  "scripts": {
    "test": "node src/cli.js",
    "matrix": "node src/cli.js --md"
  },
  "keywords": [
    "pdf",
    "conformance",
    "testing",
    "i18n",
    "accessibility",
    "cross-library"
